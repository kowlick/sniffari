{
  "name": "sniffari",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-network and remote multiplayer dog-walking game on a tiled map of San Francisco.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node src/server/index.ts",
    "dev": "node --watch src/server/index.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "map": "node scripts/make-map.mjs",
    "tune": "node scripts/tune.mjs",
    "ai-tourney": "node scripts/ai-tourney.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
